    {
      "id": "special-quote",
      "zh": "特别气配",
      "en": "Special Quote",
      "natives": {
        "ja": "特別気配"
      },
      "note": "东证机制，申报价超出值幅制限时不成交、改为显示指示性价格，是值幅制限的执行方式而非独立于价格限制之外的冷静期，与港交所VCM那种独立机制不同类"
    },
    {
      "id": "lse-price-monitoring",
      "zh": "价格监控机制",
      "en": "Price Monitoring (Static/Dynamic)",
      "natives": {
        "en": "Static Price Monitoring / Dynamic Price Monitoring"
      },
      "note": "伦敦证券交易所逐证券（非全市场）的价格监控机制，静态阈值相对上一次集合竞价价、动态阈值相对最近成交价，触发后转入波动性拍卖重新形成价格而非直接停牌；与美股LULD、港交所VCM、Eurex波动性中断同属\"触发后转拍卖\"一类，但阈值设计（按流动性分层的静态/动态双轨）是LSE特有"
    },
    {
      "id": "recognised-investment-exchange",
      "zh": "认可投资交易所",
      "en": "Recognised Investment Exchange (RIE)",
      "note": "英国法律地位，交易所自身作为一线监管方对市场准入交易与市场运作负责，与FCA依UKLR对官方名册（Official List）的监管职能并行，是\"交易所自身兼一线监管\"与\"纯外部机构监管\"之外的第三种组合"
    },
    {
      "id": "sponsor-uklr",
      "zh": "保荐人",
      "en": "Sponsor",
      "note": "UKLR框架下，官方名册发行人在特定触发事件（如须发布招股说明书、反向收购通函等）下须委任的保荐人角色，向FCA确认申请人/发行人符合相关上市规则要求；与AIM的Nominated Adviser不同——Sponsor只在触发事件发生时需要，不要求持续委任"
    },
    {
      "id": "nominated-adviser",
      "zh": "认可保荐人",
      "en": "Nominated Adviser (Nomad)",
      "note": "AIM市场特有的持续把关角色，AIM公司须始终委任一名，负责持续评估公司对AIM监管框架的适当性；与UKLR的Sponsor角色（仅特定触发事件下需要）不同，不要合并"
    },
    {
      "id": "shares-in-public-hands",
      "zh": "公众持股比例",
      "en": "Shares in Public Hands (Free Float)",
      "note": "UKLR项下官方名册的自由流通量要求，最低10%，跌破且未在合理期限内恢复可触发取消上市；概念上对应中文语境的\"公众持股量\""
    },
    {
      "id": "stamp-duty-reserve-tax",
      "zh": "印花税储备税",
      "en": "Stamp Duty Reserve Tax (SDRT)",
      "note": "英国对电子（无纸化）证券交易征收的税种，税率0.5%，经CREST系统自动代收并划付HMRC；与适用于纸质转让文书的传统印花税（Stamp Duty，见stamp-duty条）并行，两者税率相同但适用场景（电子/纸质）不同，不是同一税种的两种叫法"
    }
  ]
