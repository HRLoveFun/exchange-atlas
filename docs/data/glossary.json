{
  "terms": [
    {
      "id": "circuit-breaker-index",
      "zh": "指数熔断",
      "en": "Market-wide Circuit Breaker",
      "note": "大盘指数触发阈值后全市场暂停交易的机制，区别于个股级的波动性中断"
    },
    {
      "id": "volatility-control-mechanism",
      "zh": "波动性中断机制",
      "en": "Volatility Control Mechanism (VCM)",
      "natives": {
        "en": "Volatility Control Mechanism (VCM)"
      },
      "note": "港交所个股级机制，触发后进入冷静期，非全市场停牌"
    },
    {
      "id": "eurex-volatility-interruption",
      "zh": "波动性中断",
      "en": "Volatility Interruption",
      "natives": {
        "en": "Volatility Interruption"
      },
      "note": "Eurex机制，预期成交价超出动态/静态价格区间即触发，以集合竞价恢复交易；官方英文名与港交所VCM不同，且身兼波动性中断与\"涨跌停执行方式\"双重角色，不与volatility-control-mechanism合并一条"
    },
    {
      "id": "limit-up-limit-down",
      "zh": "涨跌限价机制",
      "en": "Limit Up-Limit Down (LULD)",
      "natives": {
        "en": "Limit Up-Limit Down (LULD)"
      },
      "note": "美国证券市场的个股价格带机制，以过去5分钟均价为基准动态计算"
    },
    {
      "id": "price-limit-percentage-band",
      "zh": "涨跌幅限制",
      "en": "Price Limit (Percentage Band)",
      "note": "以前收盘价为基准的百分比涨跌幅限制，如上交所主板 ±10%"
    },
    {
      "id": "price-limit-absolute-tiered",
      "zh": "值幅限制",
      "en": "Price Limit (Absolute Tiered)",
      "natives": {
        "ja": "値幅制限"
      },
      "note": "按价格区间分档规定绝对值幅（非百分比），日本市场典型做法；基准价称「基準値段」"
    },
    {
      "id": "reference-price",
      "zh": "基准价",
